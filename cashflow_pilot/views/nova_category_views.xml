<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="nova_category_view_list" model="ir.ui.view">
        <field name="name">nova.category.list</field>
        <field name="model">nova.category</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="direction"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="nova_category_view_form" model="ir.ui.view">
        <field name="name">nova.category.form</field>
        <field name="model">nova.category</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="code"/>
                        <field name="direction"/>
                        <field name="sequence"/>
                        <field name="color" widget="color_picker"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                        <field name="active" invisible="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="nova_category_view_search" model="ir.ui.view">
        <field name="name">nova.category.search</field>
        <field name="model">nova.category</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="code"/>
                <filter name="filter_in" string="Inflow" domain="[('direction', '=', 'in')]"/>
                <filter name="filter_out" string="Outflow" domain="[('direction', '=', 'out')]"/>
                <separator/>
                <filter name="group_by_direction" string="Direction" context="{'group_by': 'direction'}"/>
            </search>
        </field>
    </record>

    <record id="nova_category_action" model="ir.actions.act_window">
        <field name="name">Categories</field>
        <field name="res_model">nova.category</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="nova_menu_categories"
              name="Categories"
              parent="nova_menu_configuration"
              action="nova_category_action"
              sequence="20"
              groups="nova_group_manager"/>

</odoo>
