<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="nova_report_forecast_paperformat" model="report.paperformat">
        <field name="name">Cash Flow Forecast (Landscape)</field>
        <field name="format">A4</field>
        <field name="orientation">Landscape</field>
        <field name="margin_top">52</field>
        <field name="margin_bottom">20</field>
        <field name="margin_left">7</field>
        <field name="margin_right">7</field>
        <field name="header_spacing">52</field>
        <field name="dpi">90</field>
    </record>

    <record id="nova_report_forecast_pdf" model="ir.actions.report">
        <field name="name">13-Week Cash Flow Forecast</field>
        <field name="model">res.company</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">cashflow_pilot.nova_report_forecast_pdf_document</field>
        <field name="print_report_name">'Cash Flow Forecast'</field>
        <field name="paperformat_id" ref="nova_report_forecast_paperformat"/>
    </record>

</odoo>
