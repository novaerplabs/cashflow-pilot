<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="nova_module_category" model="ir.module.category">
        <field name="name">CashFlow Pilot</field>
        <field name="sequence">20</field>
    </record>

    <record id="nova_privilege_access" model="res.groups.privilege">
        <field name="name">Access Level</field>
        <field name="category_id" ref="nova_module_category"/>
    </record>

    <record id="nova_group_viewer" model="res.groups">
        <field name="name">Viewer</field>
        <field name="privilege_id" ref="nova_privilege_access"/>
        <field name="comment">View dashboards, grid, and drill-downs. Read-only.</field>
    </record>

    <record id="nova_group_user" model="res.groups">
        <field name="name">User</field>
        <field name="privilege_id" ref="nova_privilege_access"/>
        <field name="implied_ids" eval="[(4, ref('nova_group_viewer'))]"/>
        <field name="comment">Viewer + edit expected dates, manage recurring and one-off items, flag at-risk invoices.</field>
    </record>

    <record id="nova_group_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="privilege_id" ref="nova_privilege_access"/>
        <field name="implied_ids" eval="[(4, ref('nova_group_user'))]"/>
        <field name="comment">User + configuration (journals, threshold, horizon, categories), scenarios, alert settings, opening-balance override, snapshots.</field>
    </record>

</odoo>
